// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  contents           Content[]
  conversations      Conversation[]
  uploadedFiles      UploadedFile[]
  aiGenerations      AIGeneration[]
  contentAnalytics   ContentAnalytics[]
  aiUsageLogs        AIUsageLog[]
  publishingLogs     PublishingLog[]

  @@map("users")
}

model Content {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  type      String   // blog, story, linkedin, facebook, wordpress, substack, quote, caption, hashtag, seo_title, meta_description
  tags      String[] @default([])
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentAnalytics ContentAnalytics[]
  publishingLogs   PublishingLog[]

  @@index([userId])
  @@map("contents")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("conversations")
}

model UploadedFile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String   // pdf, docx, txt, markdown
  fileSize  Int
  fileUrl   String
  content   String?  @db.Text // Extracted text content
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("uploaded_files")
}

model AIGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String   @db.Text
  output      String   @db.Text
  type        String   // blog, story, linkedin, facebook, wordpress, substack, etc.
  tokensUsed  Int
  costUSD     Float?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("ai_generations")
}

model ContentAnalytics {
  id        String   @id @default(cuid())
  contentId String
  userId    String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  views     Int      @default(0)
  likes     Int      @default(0)
  shares    Int      @default(0)
  comments  Int      @default(0)
  platform  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([contentId])
  @@map("content_analytics")
}

model AIUsageLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model         String
  tokensUsed    Int
  requestType   String
  estimatedCost Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("ai_usage_logs")
}

model PublishingLog {
  id           String    @id @default(cuid())
  userId       String
  contentId    String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform     String
  status       String    @default("PENDING")
  errorMessage String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([contentId])
  @@map("publishing_logs")
}
